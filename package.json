    "test": "tsx tests/proxy-manager.test.ts && tsx tests/session.test.ts && tsx tests/commands.test.ts && tsx tests/whatsapp-connection.mock.test.ts",
    "test:proxy": "tsx tests/proxy-manager.test.ts",
    "test:session": "tsx tests/session.test.ts",
    "test:commands": "tsx tests/commands.test.ts",
    "test:wa": "tsx tests/whatsapp-connection.mock.test.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.16",
    "axios": "^1.7.9",
    "fs-extra": "^11.2.0",
    "playwright": "^1.49.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/fs-extra": "^11.0.4"
  }
