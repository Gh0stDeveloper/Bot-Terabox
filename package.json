{
  "name": "bot-terabox",
  "version": "1.0.0",
  "description": "Bot de WhatsApp dedicado a descargas de TeraBox con gestión de sesión automática",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
